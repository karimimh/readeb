# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DB_NAME=readeb
DB_USER=readeb
DB_PASSWORD=readeb
DB_HOST=localhost
DB_PORT=5432
# DB_CONN_MAX_AGE=60

# --- CORS (Next.js dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Generation mode ---
# Set to True and provide an API key below to use real LLM generation.
# When False, the backend uses a deterministic offline generator (no tokens).
USE_REAL_LLM=False
LLM_PROVIDER=openai

# --- LLM credentials (only the configured provider is required) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-1.5-flash

# --- Uploads ---
# MAX_PDF_UPLOAD_BYTES=52428800
