# ---------------------------------------------------------------------------
# FREE OPTION 1: Google Gemini (no credit card — get key at aistudio.google.com)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_KEY=AIza...

# ---------------------------------------------------------------------------
# FREE OPTION 2: Groq (free tier — get key at console.groq.com)
# Uses the OpenAI-compatible endpoint; set OPENAI_BASE_URL to override.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Paid providers
# ---------------------------------------------------------------------------
# Provider: openai | anthropic | gemini
LLM_PROVIDER=openai

# Model names per provider
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_MODEL=gemini-2.0-flash

# API keys (fill in only what you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OpenAI-compatible base URL override (leave blank for real OpenAI)
OPENAI_BASE_URL=

# TTS (optional)
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
